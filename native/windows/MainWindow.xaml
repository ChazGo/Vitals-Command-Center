<Window
    x:Class="Vitals.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Health">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" Background="Transparent" Loaded="Root_Loaded">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConnectionActions.Orientation" Value="Vertical" />
                        <Setter Target="ConnectionActions.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="520" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ConnectionActions.Orientation" Value="Horizontal" />
                        <Setter Target="ConnectionActions.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <DataTemplate x:Key="MetricCardTemplate">
                <Border Padding="22" CornerRadius="20" MinHeight="176"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="{Binding Glyph}" FontSize="17"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Value}" FontSize="36" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Unit}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid x:Name="TitleBarDragRegion" Margin="22,0,140,0" Background="Transparent">
            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/Health.png" Width="22" Height="22" />
                <TextBlock x:Name="TitleBarText" Grid.Column="1" Text="Health" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Your personal health space" FontSize="12" Margin="8,0,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="28,20,28,32" Spacing="24" MaxWidth="1320" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="YOUR DAILY PICTURE" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="140"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Your health, at a glance" FontSize="32" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="A little clarity. A healthier rhythm." Style="{StaticResource BodyText}" />
                    </StackPanel>
                    <Button x:Name="SettingsButton" Grid.Column="1" Click="Settings_Click"
                            Width="40" Height="40" Padding="0"
                            VerticalAlignment="Top" AutomationProperties.Name="Open Health settings">
                        <FontIcon x:Name="SettingsGlyph" Glyph="&#xE713;" FontSize="18" />
                        <ToolTipService.ToolTip>Settings</ToolTipService.ToolTip>
                    </Button>
                </Grid>
                <Border Padding="20" CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="ConnectionText" Text="Checking Google Health connection…"
                                   FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel x:Name="ConnectionActions" Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ConnectButton" Content="Connect Google" Click="Connect_Click" IsEnabled="False" />
                            <Button x:Name="SyncButton" Content="Sync last 30 days" Click="Sync_Click" IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}" MinHeight="40" Padding="12,6" />
                        </StackPanel>
                        <TextBlock x:Name="LastSyncText" Style="{StaticResource BodyText}" />
                        <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed"
                                     AutomationProperties.Name="Health operation in progress" />
                        <TextBlock x:Name="BusyText" TextWrapping="Wrap" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" Severity="Error"
                         Visibility="Collapsed" Closed="InfoBar_Closed" />
                <InfoBar x:Name="WarningBar" IsOpen="False" IsClosable="True" Severity="Warning" Title="Data notes"
                         Visibility="Collapsed" Closed="InfoBar_Closed" />
                <Border x:Name="WelcomePanel" Padding="22" CornerRadius="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <Border Width="44" Height="44" CornerRadius="14" HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE73E;" FontSize="22"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="A calm place for your health data" Style="{ThemeResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Bring in the data available from Google Health. Start by adding your own Google Desktop OAuth client in Settings, then connect your Google account and choose Sync. Health never fills gaps with sample data." />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Google Health cloud access does not include all data stored by Android Health Connect. Availability depends on your account, devices, permissions, and Google's API." />
                        <Button x:Name="SetupButton" Content="Set up Google Health" Click="Settings_Click"
                                HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}"
                                MinHeight="40" Padding="12,6" />
                    </StackPanel>
                </Border>
                <StackPanel Spacing="6">
                    <TextBlock Text="Daily snapshot" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="SnapshotDate" Style="{StaticResource BodyText}" Text="No health data synced yet." />
                </StackPanel>
                <Grid x:Name="MetricsGrid" ColumnSpacing="14" RowSpacing="14" SizeChanged="Metrics_SizeChanged" />
                <Border Padding="22" CornerRadius="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE708;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Sleep detail" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="SleepDetailText" TextWrapping="Wrap" />
                        <TextBlock Text="Stages are shown only when supplied by Google; they may not sum to total sleep."
                                   Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Border>
                <StackPanel Spacing="12">
                    <TextBlock Text="Recent days" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Newest first · up to 30 days · — means unavailable" Style="{StaticResource BodyText}" />
                    <TextBlock x:Name="HistoryEmptyText" Text="Sync your Google Health account to see daily history."
                               Style="{StaticResource BodyText}" />
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16" Margin="0,0,0,10" CornerRadius="14"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Date}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Activity}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Recovery}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Other}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Style="{StaticResource BodyText}"
                           Text="For personal awareness, not diagnosis or medical advice. Sync happens only when you choose it. No AI, telemetry, or background sync." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
